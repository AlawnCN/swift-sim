<!-- pacs.008 customer credit transfer (CBPR+ equivalent of MT103). MT202/MT103 remain the default settlement legs. -->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:pacs.008.001.08">
  <FIToFICstmrCdtTrf>
    <GrpHdr>
      <MsgId>${newRef}</MsgId>
      <CreDtTm>${nowUtc}</CreDtTm>
      <NbOfTxs>1</NbOfTxs>
      <SttlmInf><SttlmMtd>INDA</SttlmMtd></SttlmInf>
    </GrpHdr>
    <CdtTrfTxInf>
      <PmtId>
        <InstrId>${newRef}</InstrId>
        <EndToEndId>${e2e|lc_presRef|f20|ref}</EndToEndId>
        <UETR>${uetr}</UETR>
      </PmtId>
      <IntrBkSttlmAmt Ccy="${currency}">${amountIso}</IntrBkSttlmAmt>
      <IntrBkSttlmDt>${todayIso}</IntrBkSttlmDt>
      <ChrgBr>SHAR</ChrgBr>
      <InstgAgt><FinInstnId><BICFI>${fromBic}</BICFI></FinInstnId></InstgAgt>
      <InstdAgt><FinInstnId><BICFI>${toBic}</BICFI></FinInstnId></InstdAgt>
      <Dbtr><Nm>${applicant|'ORDERING CUSTOMER'}</Nm></Dbtr>
      <DbtrAgt><FinInstnId><BICFI>${fromBic}</BICFI></FinInstnId></DbtrAgt>
      <CdtrAgt><FinInstnId><BICFI>${toBic}</BICFI></FinInstnId></CdtrAgt>
      <Cdtr><Nm>${beneficiary|'BENEFICIARY CUSTOMER'}</Nm></Cdtr>
    </CdtTrfTxInf>
  </FIToFICstmrCdtTrf>
</Document>
