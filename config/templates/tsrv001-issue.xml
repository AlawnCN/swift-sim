  <UdrtkgIssnc>
    <UdrtkgIssncDtls>
      <Id>${ref}</Id>
      <Nm>DGAR</Nm>
      <IssncTp>ISSU</IssncTp>
      <Issr><Id><OrgId><AnyBIC>${issuerBic}</AnyBIC></OrgId></Id></Issr>
      <Bnfcry><Nm>EXAMPLE SUPPLIES LTD (FICTIONAL)</Nm></Bnfcry>
      <DtOfIssnc>${todayIso}</DtOfIssnc>
