      <XpryDtls>
        <XpryTerms><DtTm><Dt>${expiryIso}</Dt></DtTm></XpryTerms>
      </XpryDtls>
      <GovncRulesAndLaw><RuleId><Cd>URDG</Cd></RuleId></GovncRulesAndLaw>
      <UdrtkgTermsAndConds><Txt>WE HEREBY ISSUE OUR DEMAND GUARANTEE NO ${ref}. SIMULATED TEST MESSAGE - NO VALUE.</Txt></UdrtkgTermsAndConds>
    </UdrtkgIssncDtls>
  </UdrtkgIssnc>
</Document>
