<!-- tsrv.005 UndertakingAmendment initiated by the (virtual) issuer: expiry extension (MX variant of mt767-issuer-amend) -->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:tsrv.005.001.01">
  <UdrtkgAmdmnt>
    <UdrtkgAmdmntDtls>
      <SeqNb>${nextAmendmentNo|amendmentNo|'1'}</SeqNb>
      <DtOfIssnc>${todayIso}</DtOfIssnc>
      <UdrtkgId>
        <Id>${ref}</Id>
        <Issr><Id><OrgId><AnyBIC>${issuerBic}</AnyBIC></OrgId></Id></Issr>
      </UdrtkgId>
      <NewXpryDtls>
        <XpryTerms>
          <DtTm><Dt>${newExpiryIso}</Dt></DtTm>
        </XpryTerms>
        <AddtlXpryInf>EXPIRY EXTENDED AT THE REQUEST OF THE APPLICANT</AddtlXpryInf>
      </NewXpryDtls>
    </UdrtkgAmdmntDtls>
  </UdrtkgAmdmnt>
</Document>
