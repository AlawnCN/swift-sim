{
 "openapi": "3.0.3",
 "info": {
  "title": "swift-sim AI API",
  "version": "1.0",
  "description": "AI / automation access to the SWIFT trade-finance simulator (guarantees, documentary credits, collections). Bind: 127.0.0.1:8082. Auth: Authorization: Bearer <key> (config/secrets/ai-api-keys). read scope = GET + validate + preview + MCP read tools; operator scope = also trigger / respond."
 },
 "servers": [
  {
   "url": "http://127.0.0.1:8082"
  }
 ],
 "security": [
  {
   "bearer": []
  }
 ],
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "responses": {
   "Unauthorized": {
    "description": "missing or invalid key"
   }
  }
 },
 "paths": {
  "/ai/v1": {
   "get": {
    "summary": "Index: endpoints, key name and scope",
    "description": "",
    "parameters": [],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "not found"
     }
    }
   }
  },
  "/ai/v1/whoami": {
   "get": {
    "summary": "Key name and scope",
    "description": "",
    "parameters": [],
    "responses": {
