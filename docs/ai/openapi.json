       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "not found"
     }
    }
   }
  },
  "/ai/v1/messages": {
   "get": {
    "summary": "Search / poll messages",
    "description": "Without sinceId: newest first. With sinceId: oldest first after the cursor; response has cursor (last id) and hasMore.",
    "parameters": [
     {
      "name": "sinceId",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      },
      "description": "cursor: only id > sinceId, ascending (incremental polling)"
     },
     {
      "name": "beforeId",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      },
      "description": "paging backwards (descending mode)"
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      },
      "description": "max 500, default 100"
     },
     {
      "name": "ref",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "substring of field 20 / 21 / business reference"
     },
     {
      "name": "type",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "message type, e.g. MT760, 767, tsrv.001"
     },
     {
      "name": "bank",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "BIC or participant id; matches sender or receiver"
     },
     {
      "name": "from",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "sender BIC/id"
     },
     {
      "name": "to",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "receiver BIC/id"
     },
     {
      "name": "direction",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "IN (from your system), OUT (to your system), INTERNAL, SYS; comma list"
     },
     {
      "name": "format",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "MT|MX|SYS"
     },
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "gateway status ACK|NAK|DELIVERED (comma list)"
     },
     {
      "name": "business",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "APPLIED|REJECTED|INCONSISTENT|PENDING_REVIEW|DUPLICATE_IGNORED or BIZREJECT"
     },
     {
      "name": "dateFrom",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "YYYY-MM-DD or ISO date-time"
     },
     {
      "name": "dateTo",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "YYYY-MM-DD (inclusive) or ISO date-time"
     },
     {
      "name": "includeSys",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean"
      },
      "description": "include ACK/NAK/DLV/NOTE service messages"
     },
     {
      "name": "includeRaw",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean"
      },
      "description": "include raw text"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "not found"
     }
    }
   }
  },
